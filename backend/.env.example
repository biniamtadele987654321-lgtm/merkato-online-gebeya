NODE_ENV=development
PORT=5000
SEED_DEMO_DATA=false
MONGODB_URI=mongodb://127.0.0.1:27017/ethiopian_marketplace?replicaSet=rs0
# For MongoDB Atlas, replace the line above with your SRV connection string:
# MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/ethiopian_marketplace?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRES_IN=1d
ADMIN_NAME= Ashu
ADMIN_EMAIL= ashu@example.com
ADMIN_PHONE= +251912345678
ADMIN_PASSWORD= securePassword123
ADMIN_PROMOTE_EXISTING=false
CHAPA_SECRET_KEY=
TELEBIRR_API_URL=
TELEBIRR_APP_ID=
